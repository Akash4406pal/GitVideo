# ===================================================
# GitVideo Frontend: Environment Configuration
# ===================================================

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_replace_in_production
NEXTAUTH_URL=https://your-app-name.netlify.app

# GitHub OAuth Provider (Create at: https://github.com/settings/developers)
# Callback URL: https://your-app-name.netlify.app/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Provider (Create at: https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://your-app-name.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Backend Service URL
BACKEND_URL=https://your-backend-service.onrender.com
