{
  "name": "gitvideo-backend",
  "version": "1.0.0",
  "description": "GitVideo Backend Engine - Ingest, Analyze, Storyboard, and Render",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "server": "tsx watch src/server.ts",
    "pipeline": "tsx src/index.ts",
    "analyze": "tsx src/index.ts",
    "render": "tsx src/index.ts",
    "render:quick": "tsx src/index.ts --skip-render",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@remotion/bundler": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "get-mp3-duration": "^1.0.0",
    "msedge-tts": "^2.1.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
